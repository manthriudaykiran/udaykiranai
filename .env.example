# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION — AI FREEDOM WITH UDAY (V1.2)
# ==============================================================================

# 1. FRONTEND / CLIENT-SIDE VARIABLES (Exposed in browser bundle for Auth & Read)
# In Vercel: Set for Production, Preview, and Development.
# In Supabase: Project Settings -> API -> Project URL & Project API Keys (anon / public)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional alias supported by the client:
# VITE_SUPABASE_PUBLISHABLE_KEY="pk_..."

# 2. SERVER-SIDE / VERCEL SERVERLESS VARIABLES (STRICTLY PRIVATE — NEVER EXPOSE TO BROWSER)
# In Vercel: Set in Project Settings -> Environment Variables.
# In Supabase: Project Settings -> API -> Project API Keys (service_role / secret)
# Required by /api/register and /api/track to execute privileged RPCs with server-verified IP rate limiting.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Dedicated server-only salt secret for rate-limiting HMAC IP hashes (minimum 16 random chars).
# NEVER expose to browser. Must not be derived from the Supabase service role key.
# Generate via: openssl rand -hex 24
RATE_LIMIT_SALT="your-dedicated-32-char-random-salt-secret-here"
